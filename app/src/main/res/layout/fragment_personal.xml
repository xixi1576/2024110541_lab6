<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="10dp"
            android:text="@string/title_info"
            android:textColor="@color/text_red"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="12dp"
            android:text="@string/profile_tip"
            android:textColor="@color/text_red"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/LabFormLabel"
                android:text="@string/label_name" />

            <EditText
                android:id="@+id/edit_name"
                style="@style/LabFormInput" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/LabFormLabel"
                android:text="@string/label_student_id" />

            <EditText
                android:id="@+id/edit_student_id"
                style="@style/LabFormInput" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/LabFormLabel"
                android:text="@string/label_college" />

            <EditText
                android:id="@+id/edit_college"
                style="@style/LabFormInput" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/LabFormLabel"
                android:text="@string/label_major" />

            <EditText
                android:id="@+id/edit_major"
                style="@style/LabFormInput" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/LabFormLabel"
                android:text="@string/label_hobby" />

            <EditText
                android:id="@+id/edit_hobby"
                style="@style/LabFormInput" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/button_save"
                style="@style/LabButton"
                android:layout_marginEnd="8dp"
                android:text="@string/action_save" />

            <TextView
                android:id="@+id/button_clear_history"
                style="@style/LabButton"
                android:text="@string/action_clear_history" />
        </LinearLayout>

        <TextView
            android:id="@+id/text_history_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:paddingBottom="6dp"
            android:text="@string/history_title"
            android:textColor="@color/text_red"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/text_history"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/bar_bg"
            android:padding="10dp"
            android:text="@string/history_empty"
            android:textColor="@color/text_red"
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>
